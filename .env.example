# Contact form delivery (https://resend.com). Leave empty in local dev:
# submissions are then logged to the server console instead of emailed.
RESEND_API_KEY=
# Inbox that receives enquiries
CONTACT_TO=contact@linkinworldtech.com
# Verified sender on your Resend domain
CONTACT_FROM="Linkin World website <website@linkinworldtech.com>"
